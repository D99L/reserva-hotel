<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vista Admin - Sistema de Reservas</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100 font-sans">
    <nav class="bg-blue-900 text-white p-4 shadow-md sticky top-0 z-50">
        <div class="container mx-auto flex justify-between items-center">
            <h1 class="text-xl font-bold"><i class="fas fa-hotel mr-2"></i>Sistema de Reservas</h1>
            <div class="space-x-4">
                <a href="/" class="hover:text-blue-300 font-semibold px-2 py-1 rounded"><i class="fas fa-user mr-1"></i> Vista Turista</a>
                <a href="/admin" class="hover:text-blue-300 font-semibold px-2 py-1 rounded bg-blue-800"><i class="fas fa-user-tie mr-1"></i> Vista Admin</a>
            </div>
        </div>
    </nav>

    <section class="p-6 container mx-auto">
        <div class="flex flex-col md:flex-row gap-6">
            
            <div class="w-full md:w-64 bg-gray-800 text-white rounded-lg shadow-lg p-4">
                <div class="text-center mb-6">
                    <div class="w-20 h-20 bg-gray-600 rounded-full mx-auto flex items-center justify-center mb-2">
                        <i class="fas fa-user-shield text-3xl"></i>
                    </div>
                    <h3 class="font-bold">Administrador</h3>
                </div>
                <ul class="space-y-2">
                    <li><a href="#" class="block py-2 px-4 bg-blue-600 rounded"><i class="fas fa-tachometer-alt mr-2"></i> Dashboard</a></li>
                    <li><a href="#" class="block py-2 px-4 hover:bg-gray-700 rounded"><i class="fas fa-book mr-2"></i> Reservas</a></li>
                </ul>
            </div>

            <div class="flex-1 bg-white rounded-lg shadow-lg p-6">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-2xl font-bold text-gray-800">Panel de Control - Reservas</h2>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
                    <div class="bg-blue-50 p-4 rounded border-l-4 border-blue-500">
                        <h4 class="text-gray-500 text-sm font-bold uppercase">Total Reservas</h4>
                        <span class="text-2xl font-bold text-gray-800"><%= reservas.length %></span>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-100 text-gray-700">
                                <th class="py-3 px-4 border-b">ID Reserva</th>
                                <th class="py-3 px-4 border-b">Cliente</th>
                                <th class="py-3 px-4 border-b">Habitación</th>
                                <th class="py-3 px-4 border-b">Fechas</th>
                                <th class="py-3 px-4 border-b">Estado</th>
                                <th class="py-3 px-4 border-b">Total</th>
                            </tr>
                        </thead>
                        <tbody class="text-gray-600">
                            <% reservas.forEach(function(res) { %>
                            <tr class="hover:bg-gray-50">
                                <td class="py-3 px-4 border-b font-mono text-sm">#RES-<%= res.reserva_id %></td>
                                <td class="py-3 px-4 border-b">
                                    <div class="font-bold"><%= res.nombre_cliente %> <%= res.apellido_cliente %></div>
                                    <div class="text-xs text-gray-500"><%= res.correo_cliente %></div>
                                </td>
                                <td class="py-3 px-4 border-b"><%= res.hotel_nombre %> - Hab <%= res.numero_habitacion %></td>
                                <td class="py-3 px-4 border-b">
                                    <div class="text-sm"><%= res.fecha_entrada %> → <%= res.fecha_salida %></div>
                                </td>
                                <td class="py-3 px-4 border-b">
                                    <% if(res.estado === 'Confirmada') { %>
                                        <span class="bg-green-100 text-green-800 text-xs font-bold px-2 py-1 rounded-full"><%= res.estado %></span>
                                    <% } else { %>
                                        <span class="bg-yellow-100 text-yellow-800 text-xs font-bold px-2 py-1 rounded-full"><%= res.estado %></span>
                                    <% } %>
                                </td>
                                <td class="py-3 px-4 border-b">$<%= res.total.toLocaleString('es-CL') %></td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</body>
</html>
