<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión - Sistema de Reservas</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100 font-sans h-screen flex items-center justify-center">
    
    <div class="bg-white p-8 rounded-lg shadow-lg max-w-md w-full">
        <div class="text-center mb-8">
            <h1 class="text-2xl font-bold text-blue-900"><i class="fas fa-hotel mr-2"></i>Sistema de Reservas</h1>
            <p class="text-gray-600 mt-2">Inicia sesión para continuar</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
                <span class="block sm:inline">
                    <% if (error === 'credenciales_invalidas') { %>
                        Credenciales inválidas. Intente nuevamente.
                    <% } else if (error === 'debe_iniciar_sesion') { %>
                        Debe iniciar sesión para realizar una reserva.
                    <% } else { %>
                        Ocurrió un error.
                    <% } %>
                </span>
            </div>
        <% } %>

        <form action="/login" method="POST">
            <div class="mb-4">
                <label class="block text-gray-700 text-sm font-bold mb-2" for="correo">
                    Correo Electrónico
                </label>
                <input class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" id="correo" type="email" name="correo" required placeholder="correo@ejemplo.cl">
            </div>
            <div class="mb-6">
                <label class="block text-gray-700 text-sm font-bold mb-2" for="rut">
                    RUT (Contraseña)
                </label>
                <input class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" id="rut" type="password" name="rut" required placeholder="1111111-1">
                <p class="text-xs text-gray-500 mt-2">Use su RUT como contraseña para este prototipo.</p>
            </div>
            
            <div class="flex items-center justify-between">
                <button class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline w-full" type="submit">
                    Ingresar
                </button>
            </div>
        </form>

        <div class="mt-6 text-center text-sm text-gray-600">
            <a href="/" class="text-blue-500 hover:text-blue-800"><i class="fas fa-arrow-left"></i> Volver al inicio</a>
        </div>
        
        <div class="mt-6 p-4 bg-gray-50 rounded text-xs text-gray-600">
            <p class="font-bold mb-1">Usuarios de prueba:</p>
            <ul class="list-disc pl-4">
                <li>Admin: admin@hotel.cl / 1111111-1</li>
                <li>Turista: adolfo.leal@correo.cl / 2222222-2</li>
            </ul>
        </div>
    </div>

</body>
</html>
