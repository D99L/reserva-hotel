<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vista Turista - Sistema de Reservas</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100 font-sans">
    <nav class="bg-blue-900 text-white p-4 shadow-md sticky top-0 z-50">
        <div class="container mx-auto flex justify-between items-center">
            <h1 class="text-xl font-bold"><i class="fas fa-hotel mr-2"></i>Sistema de Reservas</h1>
            <div class="space-x-4 flex items-center">
                <a href="/" class="hover:text-blue-300 font-semibold px-2 py-1 rounded bg-blue-800"><i class="fas fa-home mr-1"></i> Inicio</a>
                <span class="text-sm border-l pl-4 ml-2 border-blue-700">Hola, <%= usuario.nombre %></span>
                <a href="/logout" class="hover:text-red-300 text-sm font-semibold px-2 py-1 rounded text-red-200"><i class="fas fa-sign-out-alt"></i> Salir</a>
            </div>
        </div>
    </nav>

    <section class="p-6 container mx-auto">
        <div class="bg-white rounded-lg shadow-lg overflow-hidden">
            <header class="bg-blue-600 p-6 text-white text-center">
                <h2 class="text-3xl font-bold">Encuentra tu Alojamiento Ideal</h2>
                <p class="mt-2 text-blue-100">Hoteles de primera categoría en todo el país</p>
            </header>

            <% if (typeof query !== 'undefined' && query.success) { %>
                <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative m-6" role="alert">
                    <span class="block sm:inline">
                        <% if (query.success === 'reserva_creada') { %>
                            ¡Reserva y pago completados con éxito!
                        <% } %>
                    </span>
                </div>
            <% } %>
            
            <% if (typeof query !== 'undefined' && query.error) { %>
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative m-6" role="alert">
                    <span class="block sm:inline">
                        <% if (query.error === 'fechas_invalidas') { %>
                            Las fechas seleccionadas no son válidas.
                        <% } else { %>
                            Ocurrió un error al procesar la solicitud.
                        <% } %>
                    </span>
                </div>
            <% } %>

            <!-- Resultados -->
            <div class="p-6">
                <div id="api-error-container"></div>
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-xl font-semibold text-gray-800">Habitaciones Disponibles</h3>
                    <div class="flex items-center">
                        <label for="currency-selector" class="mr-2 text-sm font-medium text-gray-700">Moneda:</label>
                        <select id="currency-selector" class="border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm p-2 border">
                            <option value="CLP">CLP ($)</option>
                            <option value="USD">USD (US$)</option>
                            <option value="EUR">EUR (€)</option>
                        </select>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    
                    <% habitaciones.forEach(function(hab) { %>
                    <div class="border rounded-lg overflow-hidden shadow-sm hover:shadow-md transition">
                        <div class="h-48 bg-gray-300 flex items-center justify-center text-gray-500">
                            <i class="fas fa-image text-4xl"></i>
                        </div>
                        <div class="p-4">
                            <div class="flex justify-between items-start">
                                <div>
                                    <h4 class="font-bold text-lg text-gray-800">Habitación <%= hab.tipo %></h4>
                                    <p class="text-sm text-gray-600"><i class="fas fa-map-marker-alt text-red-500"></i> <%= hab.hotel_nombre %> - <%= hab.ciudad %></p>
                                </div>
                                <% if(hab.estado === 'Disponible') { %>
                                    <span class="bg-green-100 text-green-800 text-xs font-semibold px-2 py-1 rounded">Disponible</span>
                                <% } else { %>
                                    <span class="bg-red-100 text-red-800 text-xs font-semibold px-2 py-1 rounded">Ocupada</span>
                                <% } %>
                            </div>
                            <div class="mt-4 flex gap-2 text-sm text-gray-600">
                                <span><i class="fas fa-user"></i> Máx <%= hab.capacidad %></span>
                                <span><i class="fas fa-hashtag"></i> N° <%= hab.numero %></span>
                            </div>
                            <div class="mt-4 flex justify-between items-end border-t pt-4">
                                <div>
                                    <span class="text-2xl font-bold text-blue-600"><span class="currency-symbol">$</span><span class="price-amount" data-clp="<%= hab.precio %>"><%= hab.precio.toLocaleString('es-CL') %></span></span><span class="text-sm text-gray-500">/noche</span>
                                </div>
                                <% if(hab.estado === 'Disponible') { %>
                                    <form action="/reservar" method="POST" class="m-0 flex flex-col gap-2">
                                        <input type="hidden" name="habitacion_id" value="<%= hab.habitacion_id %>">
                                        <div class="flex gap-2">
                                            <div>
                                                <label class="text-xs text-gray-500">Entrada</label>
                                                <input type="date" name="fecha_entrada" required class="border rounded px-2 py-1 text-xs w-full">
                                            </div>
                                            <div>
                                                <label class="text-xs text-gray-500">Salida</label>
                                                <input type="date" name="fecha_salida" required class="border rounded px-2 py-1 text-xs w-full">
                                            </div>
                                        </div>
                                        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded text-sm font-semibold w-full">Reservar</button>
                                    </form>
                                <% } else { %>
                                    <button disabled class="bg-gray-400 text-white px-4 py-2 rounded text-sm font-semibold cursor-not-allowed">No Disponible</button>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <% }); %>
                    
                </div>
            </div>
        </div>
    </section>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const currencySelect = document.getElementById('currency-selector');
            const priceElements = document.querySelectorAll('.price-amount');
            const currencySymbols = document.querySelectorAll('.currency-symbol');
            const errorContainer = document.getElementById('api-error-container');

            currencySelect.addEventListener('change', async (e) => {
                const target = e.target.value;
                errorContainer.innerHTML = '';
                
                if (target === 'CLP') {
                    priceElements.forEach(el => {
                        const clp = parseInt(el.getAttribute('data-clp'));
                        el.textContent = clp.toLocaleString('es-CL');
                    });
                    currencySymbols.forEach(el => el.textContent = '$');
                    return;
                }

                try {
                    // UI Feedback: disable selector while loading
                    currencySelect.disabled = true;
                    
                    const response = await fetch(`/api/exchange-rate?target=${target}`);
                    const data = await response.json();
                    
                    if (!response.ok) {
                        throw new Error(data.message || `Error ${response.status}`);
                    }
                    
                    if (data.success && data.rate) {
                        const symbol = target === 'USD' ? 'US$' : (target === 'EUR' ? '€' : target);
                        priceElements.forEach(el => {
                            const clp = parseInt(el.getAttribute('data-clp'));
                            const converted = clp * data.rate;
                            el.textContent = converted.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        });
                        currencySymbols.forEach(el => el.textContent = symbol);
                    }
                } catch (error) {
                    console.error(error);
                    errorContainer.innerHTML = `
                        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
                            <strong>Error al obtener tipo de cambio:</strong> ${error.message}
                        </div>
                    `;
                    // Revert to CLP on error
                    currencySelect.value = 'CLP';
                    priceElements.forEach(el => {
                        const clp = parseInt(el.getAttribute('data-clp'));
                        el.textContent = clp.toLocaleString('es-CL');
                    });
                    currencySymbols.forEach(el => el.textContent = '$');
                } finally {
                    currencySelect.disabled = false;
                }
            });
        });
    </script>
</body>
</html>
