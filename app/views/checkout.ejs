<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout - Sistema de Reservas</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100 font-sans">
    <nav class="bg-blue-900 text-white p-4 shadow-md sticky top-0 z-50">
        <div class="container mx-auto flex justify-between items-center">
            <h1 class="text-xl font-bold"><i class="fas fa-hotel mr-2"></i>Sistema de Reservas</h1>
            <div class="space-x-4 flex items-center">
                <a href="/" class="hover:text-blue-300 font-semibold px-2 py-1 rounded bg-blue-800"><i class="fas fa-home mr-1"></i> Inicio</a>
                <span class="text-sm border-l pl-4 ml-2 border-blue-700">Hola, <%= usuario.nombre %></span>
                <a href="/logout" class="hover:text-red-300 text-sm font-semibold px-2 py-1 rounded text-red-200"><i class="fas fa-sign-out-alt"></i> Salir</a>
            </div>
        </div>
    </nav>

    <section class="p-6 container mx-auto max-w-2xl">
        <div class="bg-white rounded-lg shadow-lg overflow-hidden">
            <header class="bg-blue-600 p-6 text-white text-center">
                <h2 class="text-2xl font-bold">Confirma tu Reserva y Pago</h2>
            </header>

            <div class="p-6">
                <h3 class="text-xl font-semibold mb-4 text-gray-800">Detalles de la Reserva</h3>
                <div class="bg-gray-50 p-4 rounded border mb-6">
                    <p><strong>Hotel:</strong> <%= habitacion.hotel_nombre %> - <%= habitacion.ciudad %></p>
                    <p><strong>Habitación:</strong> <%= habitacion.tipo %> (N° <%= habitacion.numero %>)</p>
                    <p><strong>Check-in:</strong> <%= fecha_entrada %></p>
                    <p><strong>Check-out:</strong> <%= fecha_salida %></p>
                    <p><strong>Noches:</strong> <%= noches %></p>
                    <hr class="my-2">
                    <p class="text-lg"><strong>Total a Pagar:</strong> <span class="text-blue-600 font-bold">$<%= total.toLocaleString('es-CL') %></span></p>
                </div>

                <h3 class="text-xl font-semibold mb-4 text-gray-800">Método de Pago</h3>
                <form action="/checkout" method="POST">
                    <input type="hidden" name="habitacion_id" value="<%= habitacion.habitacion_id %>">
                    <input type="hidden" name="fecha_entrada" value="<%= fecha_entrada %>">
                    <input type="hidden" name="fecha_salida" value="<%= fecha_salida %>">
                    <input type="hidden" name="total" value="<%= total %>">
                    
                    <div class="mb-4">
                        <label class="block text-gray-700 text-sm font-bold mb-2">Seleccione Método</label>
                        <select name="metodo_pago" required class="shadow border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
                            <option value="Tarjeta de Crédito">Tarjeta de Crédito</option>
                            <option value="Tarjeta de Débito">Tarjeta de Débito</option>
                            <option value="Transferencia">Transferencia Bancaria</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="block text-gray-700 text-sm font-bold mb-2">Número de Tarjeta (Simulado)</label>
                        <input type="text" placeholder="XXXX-XXXX-XXXX-XXXX" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
                    </div>
                    
                    <div class="flex gap-4 mb-4">
                        <div class="w-1/2">
                            <label class="block text-gray-700 text-sm font-bold mb-2">Vencimiento</label>
                            <input type="text" placeholder="MM/YY" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
                        </div>
                        <div class="w-1/2">
                            <label class="block text-gray-700 text-sm font-bold mb-2">CVV</label>
                            <input type="text" placeholder="123" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
                        </div>
                    </div>

                    <div class="flex items-center justify-between mt-6">
                        <a href="/" class="text-blue-500 hover:text-blue-800 text-sm font-semibold">Volver</a>
                        <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-6 rounded focus:outline-none focus:shadow-outline">
                            Pagar y Confirmar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </section>
</body>
</html>
